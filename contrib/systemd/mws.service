# Example systemd service unit for mws, running directly on the host
# (no container), equivalent to the podman quadlet example in
# contrib/quadlet/mws.container.
#
# Install as a system service:
#   run0 install -D -m 0644 mws.service /etc/systemd/system/mws.service
#   run0 install -D -m 0644 mws.yaml /etc/mws/config.yaml
#   run0 mkdir -p /etc/mws/certs /srv/mws/htdocs
#   # put fullchain.pem/privkey.pem in /etc/mws/certs, or remove the
#   # tlskey/tlscert lines from /etc/mws/config.yaml to let mws generate a
#   # temporary self-signed certificate instead
#   run0 systemctl daemon-reload
#   run0 systemctl enable --now mws.service

[Unit]
Description=Mini-Webserver (mws)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/mws --config /etc/mws/config.yaml --dir /srv/mws/htdocs
Restart=on-failure
TimeoutStartSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
